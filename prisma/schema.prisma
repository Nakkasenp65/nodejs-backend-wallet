// --- Prisma Schema - Latest Version ---

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// --- Enums ---

enum MissionType {
  ONBOARDING
  ACCUMULATION
  STREAK
  REFERRAL
  DELETE
  // ประเภทสะสมยอด ประเภททำครั้งแรก ประเภทออมต่อเนื่อง เชิญเพื่อน
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum Choice {
  DAILY
  WEEKLY
  HALF_MONTH
  MONTHLY
}

enum NotificationType {
  WALLET
  REWARD
  SYSTEM
}

enum TransactionType {
  OUTCOME
  INCOME
  WITHDRAW
  DEPOSIT
  REWARD
}

enum TransactionStatus {
  PENDING
  SUCCESS
  CANCELLED
  REJECTED
}

enum UserMissionStatus {
  ENROLLED // กำลังทำภารกิจ
  AWAITING_CLAIM // ทำเงื่อนไขสำเร็จแล้ว, รอผู้ใช้มากดรับรางวัล
  CLAIMED // ผู้ใช้กดรับรางวัลไปแล้ว
  EXPIRED // หมดเวลาในการทำภารกิจ (ทำไม่สำเร็จ)
  CLAIM_EXPIRED // หมดเวลาในการกดรับรางวัล (ทำสำเร็จแต่ไม่มากดรับ)
}

enum VoucherStatus {
  ISSUED
  REDEEMED
  EXPIRED
  CANCELLED
}

enum Role {
  USER
  ADMIN
}

// --- Core Models ---

model User {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  line_user_id      String   @unique
  line_display_name String?
  fullname          String?
  phone             String?
  pin               String?
  occupation        String?
  ageRange          String?
  line_profile_url  String?
  monthlyPayment    Float?
  chat_url          String?
  isLocked          Boolean? @default(false)
  referralCode      String   @unique
  referToCode       String?
  email             String?
  firstTime         Boolean  @default(true)
  role              Role     @default(USER)

  // Saving Streaks & Insights
  currentSavingStreak Int       @default(0)
  longestSavingStreak Int       @default(0)
  lastSavingActivity  DateTime?

  // Relations
  goal          Goal?
  wallet        Wallet?
  notifications Notification[]
  userMissions  UserMission[]
  vouchers      Voucher[]

  // Referral Relations
  madeReferrals  Referral[] @relation("MadeReferrals")
  referralRecord Referral?  @relation("WasReferred")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Wallet {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  balance        Float  @default(0) // Real, withdrawable money
  bonusBalance   Float  @default(0) // Non-withdrawable bonus money
  walletUniqueId String @unique // 1WL-XXXXXX (random number) @unique

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique @db.ObjectId

  sentTransaction     Transaction[] @relation("SentTransactions")
  receieveTransaction Transaction[] @relation("ReceiveTransaction")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id     String            @id @default(auto()) @map("_id") @db.ObjectId
  name   String?
  amount Float?
  type   TransactionType?
  status TransactionStatus @default(PENDING)
  from   String?

  fromWallet   Wallet? @relation("SentTransactions", fields: [fromWalletId], references: [id])
  fromWalletId String? @db.ObjectId

  toWallet   Wallet? @relation("ReceiveTransaction", fields: [toWalletId], references: [id])
  toWalletId String? @db.ObjectId

  to             String?
  description    String?
  slipImageUrl   String?
  bank           String?
  verified       Boolean @default(false)
  verifiedAmount Float?

  externalSource String?

  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([toWalletId, status, createdAt(sort: Desc)])
  @@index([fromWalletId, status, createdAt(sort: Desc)])
  @@index([fromWalletId, toWalletId, status, createdAt(sort: Desc)])
}

model Goal {
  id     String     @id @default(auto()) @map("_id") @db.ObjectId
  status GoalStatus @default(ACTIVE)

  plan   Plan   @relation(fields: [planId], references: [id])
  planId String @db.ObjectId

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique @db.ObjectId

  product   Product @relation(fields: [productId], references: [id])
  productId String  @db.ObjectId

  voucher Voucher? // Relation to a generated voucher

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Mission {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  title            String?
  description      String?
  type             MissionType @default(STREAK)
  rewardAmount     Float?
  webExpiresAt     DateTime?
  durationDays     Int?
  completeProgress Int?

  enrolledBy UserMission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserMission {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  currentProgress  Int               @default(0)
  completeProgress Int
  status           UserMissionStatus @default(ENROLLED)
  enrolledAt       DateTime          @default(now())
  userExpiresAt    DateTime

  completedAt    DateTime? // เวลาที่ทำเงื่อนไขสำเร็จ (currentProgress >= completeProgress)
  claimExpiresAt DateTime? // เวลาที่สิทธิ์ในการกดรับรางวัลจะหมดอายุ (completedAt + 24 ชั่วโมง)
  claimedAt      DateTime? // เวลาที่ผู้ใช้กดรับรางวัลจริงๆ

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @db.ObjectId

  mission   Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
  missionId String?  @db.ObjectId

  @@unique([userId, missionId])
}

model Broadcast {
  id    String  @id @default(auto()) @map("_id") @db.ObjectId
  title String
  body  String?
  // type ไม่จำเป็นต้องมี เพราะเราจะถือว่าทั้งหมดเป็น SYSTEM/PROMOTION

  status String    @default("DRAFT") // DRAFT, SENT
  sentAt DateTime? // เวลาที่กดส่งจริง

  sentToUserCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id       String           @id @default(auto()) @map("_id") @db.ObjectId
  title    String
  body     String?
  imageUrl String?
  type     NotificationType
  isRead   Boolean          @default(false)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @db.ObjectId

  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  transactionId String?      @db.ObjectId

  createdAt DateTime @default(now())
}

model Plan {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  name        Choice
  displayName String
  goals       Goal[]
}

model Product {
  id                  String  @id @default(auto()) @map("_id") @db.ObjectId
  uniqueId            String?
  brand               String?
  model               String?
  capacity            String?
  color               String?
  price               Int?
  imageUrl            String?
  downPaymentAmount   Int?
  downPaymentPercent  Int?
  installment6Months  Int?
  installment10Months Int?
  condition           String? @default("มือหนึ่ง")

  targetedByGoals Goal[]
  vouchers        Voucher[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([downPaymentAmount])
  @@index([brand, downPaymentAmount])
}

model Brand {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SlipDecoded {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  decodedContent String
  createdAt      DateTime @default(now())
}

model Voucher {
  id         String        @id @default(auto()) @map("_id") @db.ObjectId
  code       String        @unique
  amount     Float
  status     VoucherStatus @default(ISSUED)
  issuedAt   DateTime      @default(now())
  expiresAt  DateTime
  redeemedAt DateTime?

  user   User   @relation(fields: [userId], references: [id])
  userId String @db.ObjectId

  goal   Goal   @relation(fields: [goalId], references: [id])
  goalId String @unique @db.ObjectId

  product   Product @relation(fields: [productId], references: [id])
  productId String  @db.ObjectId

  @@index([userId, status])
}

model Referral {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  rewardGiven Boolean  @default(false)
  createdAt   DateTime @default(now())

  referrer   User   @relation("MadeReferrals", fields: [referrerId], references: [id], onDelete: Cascade)
  referrerId String @db.ObjectId

  newcomer   User   @relation("WasReferred", fields: [newcomerId], references: [id], onDelete: Cascade)
  newcomerId String @unique @db.ObjectId
}
